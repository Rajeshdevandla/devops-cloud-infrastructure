{
  "title": "Platform Overview",
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (service)"}]
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "targets": [{"expr": "sum(rate(http_requests_total{status=~'5..'}[5m]))"}]
    },
    {
      "title": "P99 Latency",
      "type": "graph",
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))"}]
    },
    {
      "title": "Pod Count by Namespace",
      "type": "stat",
      "targets": [{"expr": "count(kube_pod_info) by (namespace)"}]
    }
  ]
}
